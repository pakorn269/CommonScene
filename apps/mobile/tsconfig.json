{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@commonscene/catalog": ["../../packages/catalog/src/index.ts"],
      "@commonscene/consensus": ["../../packages/consensus/src/index.ts"],
      "@commonscene/contracts": ["../../packages/contracts/src/index.ts"],
      "@commonscene/test-fixtures": ["../../packages/test-fixtures/src/index.ts"],
      "@commonscene/ui-tokens": ["../../packages/ui-tokens/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
