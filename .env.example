# CommonScene — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit a real .env file.

# ─── API Service ────────────────────────────────────────────────────────────────

# Port the Fastify API server listens on (local development)
API_PORT=3001

# Host the API server binds to
API_HOST=0.0.0.0

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# Room expiry in seconds (default: 2 hours)
ROOM_TTL_SECONDS=7200

# Rate-limit: max room creations per IP per minute
RATE_LIMIT_ROOM_CREATE=5

# ─── AWS ────────────────────────────────────────────────────────────────────────

# AWS region for Bedrock and DynamoDB
AWS_REGION=us-east-1

# AWS credentials (use IAM roles in production; only for local dev)
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ─── Amazon Bedrock ─────────────────────────────────────────────────────────────

# Set to "true" to enable Bedrock; "false" to use template provider only
BEDROCK_ENABLED=false

# Model ID for preference parsing and explanation generation
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Bedrock call timeout in milliseconds
BEDROCK_TIMEOUT_MS=8000

# ─── DynamoDB ───────────────────────────────────────────────────────────────────

# Set to "true" to use DynamoDB instead of in-memory repository
DYNAMODB_ENABLED=false

# DynamoDB table name for rooms
DYNAMODB_ROOMS_TABLE=commonscene-rooms

# Override endpoint for DynamoDB Local (leave empty for real AWS)
# DYNAMODB_ENDPOINT=http://localhost:8000

# ─── Mobile PWA ─────────────────────────────────────────────────────────────────

# Full URL of the API service (used by the mobile PWA at build time)
VITE_API_URL=http://localhost:3001

# WebSocket URL for real-time room updates
VITE_WS_URL=ws://localhost:3001
