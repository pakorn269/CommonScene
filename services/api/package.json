{
    "name": "@commonscene/api",
    "version": "0.1.0",
    "private": true,
    "description": "CommonScene Fastify API and WebSocket server",
    "license": "Apache-2.0",
    "type": "module",
    "main": "./dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "start": "node dist/index.js",
        "build": "tsc --build",
        "typecheck": "tsc --build --noEmit",
        "test": "vitest run",
        "clean": "rimraf dist tsconfig.tsbuildinfo"
    },
    "dependencies": {
        "@aws-sdk/client-bedrock-runtime": "^3.1124.0",
        "@commonscene/catalog": "*",
        "@commonscene/consensus": "*",
        "@commonscene/contracts": "*",
        "@fastify/cors": "^9.0.1",
        "@fastify/sensible": "^5.6.0",
        "@fastify/websocket": "^10.0.1",
        "dotenv": "^17.4.2",
        "fastify": "^4.28.1",
        "ws": "^8.18.0",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/node": "^22.5.1",
        "@types/ws": "^8.5.10",
        "rimraf": "^6.0.1",
        "tsx": "^4.17.0",
        "typescript": "^5.5.4",
        "vitest": "^2.0.5"
    }
}
