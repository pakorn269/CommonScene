{
    "name": "commonscene",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Fire TV-first group movie recommendation experience — Amazon Developer Hackathon 2026",
    "license": "Apache-2.0",
    "workspaces": [
        "apps/*",
        "services/*",
        "packages/*",
        "infrastructure/*"
    ],
    "scripts": {
        "lint": "eslint . --max-warnings 0",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc --build && tsc -p apps/mobile/tsconfig.json --noEmit && tsc -p apps/tv/tsconfig.json --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "build": "npm run build --workspaces --if-present",
        "clean": "npm run clean --workspaces --if-present && rimraf node_modules"
    },
    "devDependencies": {
        "@eslint/js": "^9.9.0",
        "@types/node": "^22.5.1",
        "@typescript-eslint/eslint-plugin": "^8.3.0",
        "@typescript-eslint/parser": "^8.3.0",
        "@vitest/coverage-v8": "^2.0.5",
        "eslint": "^9.9.0",
        "eslint-config-prettier": "^9.1.0",
        "prettier": "^3.3.3",
        "rimraf": "^6.0.1",
        "typescript": "^5.5.4",
        "vitest": "^2.0.5"
    },
    "engines": {
        "node": ">=20.0.0",
        "npm": ">=10.0.0"
    }
}
